   "source": [
    "## 4. Watershed Segmentation\n",
    "\n",
    "Before watershed, beads are often one connected component."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Found 10 objects.\n"
     ]
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "4ca7007dcee5454dbb41cc7487d4945f",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "IntSlider(value=138, description='Slice', max=276)"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "fc3a0791230e457c9212f947ab15de60",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "Output()"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "a1d8af566f5d4627bd172ff83cac9bd2",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "Output()"
      ]
     },
     "execution_count": 30,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "distance = ndimage.distance_transform_edt(opened)\n",
    "coords = feature.peak_local_max(distance, min_distance=8, labels=opened)\n",
    "mask_peaks = np.zeros(distance.shape, dtype=bool)\n",
    "mask_peaks[tuple(coords.T)] = True\n",
    "markers, _ = ndimage.label(mask_peaks)\n",
    "labels = segmentation.watershed(-distance, markers, mask=opened)\n",
    "print(f\"Found {labels.max()} objects.\")\n",
    "\n",
    "out2 = widgets.Output()\n",
    "def update_results_plot(slice_idx):\n",
    "    with out2:\n",
    "        clear_output(wait=True)\n",
    "        fig, ax = plt.subplots(1, 2, figsize=(14, 7))\n",
    "        slice_img = data[:, :, slice_idx]\n",
    "        slice_labels = labels[:, :, slice_idx]\n",
    "\n",
    "        ax[0].imshow(slice_img, cmap=\"gray\")\n",
    "        ax[0].set_title(f'CT slice {slice_idx}')\n",
    "        ax[0].axis('off')\n",
    "\n",
    "        # Create a categorical colormap where label 0 is transparent\n",
    "        from matplotlib import colors as mcolors\n",
    "        n_labels = max(1, labels.max())\n",
    "        base_cmap = plt.cm.get_cmap('nipy_spectral', n_labels + 1)\n",
    "        colors = base_cmap(np.linspace(0, 1, n_labels + 1))\n",
    "        colors[0] = (0, 0, 0, 0)  # make background transparent\n",
    "        listed = mcolors.ListedColormap(colors)\n",
    "        bounds = np.arange(-0.5, n_labels + 1 + 0.5)\n",
    "        norm = mcolors.BoundaryNorm(bounds, listed.N)\n",
    "\n",
    "        ax[1].imshow(slice_img, cmap='gray')\n",
    "        ax[1].imshow(slice_labels, cmap=listed, norm=norm, alpha=0.65, interpolation='nearest')\n",
    "        ax[1].set_title(f'Watershed labels (N={n_labels})')\n",
    "        ax[1].axis('off')\n",
    "\n",
    "        # draw thin black contours for clarity\n",
    "        contours = measure.find_contours(slice_labels, 0.5)\n",
    "        for contour in contours:\n",
    "            ax[1].plot(contour[:, 1], contour[:, 0], linewidth=0.5, color='k')\n",
    "\n",
    "        plt.show(); plt.close(fig)\n",
    "res_slider = IntSlider(min=0, max=data.shape[2]-1, value=data.shape[2]//2, continuous_update=True, description=\"Slice\")\n",
    "display(res_slider, out2)\n",
    "widgets.interactive_output(update_results_plot, {\"slice_idx\": res_slider})"
   ]
  },
