   "source": [
    "chosen_threshold = thresh_slider.value\n",
    "binary = data > chosen_threshold\n",
    "selem = morphology.ball(2)\n",
    "opened = morphology.binary_opening(binary, selem)\n",
    "print(\"Opening complete.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "m4",
   "metadata": {},
   "source": [
    "## 3. 3D Visualization"
