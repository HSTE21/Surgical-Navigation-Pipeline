   "source": [
    "out1 = widgets.Output()\n",
    "def update_threshold_plot(slice_idx, threshold):\n",
    "    with out1:\n",
    "        clear_output(wait=True)\n",
    "        binary = data[:, :, slice_idx] > threshold\n",
    "        fig, ax = plt.subplots(1, 2, figsize=(12, 5))\n",
    "        ax[0].imshow(data[:, :, slice_idx], cmap=\"gray\")\n",
    "        ax[1].imshow(binary, cmap=\"gray\")\n",
    "        plt.show(); plt.close(fig)\n",
    "\n",
    "slice_slider = IntSlider(min=0, max=data.shape[2]-1, value=data.shape[2]//2, continuous_update=True, description=\"Slice\")\n",
    "thresh_slider = FloatSlider(min=np.min(data), max=np.max(data), value=1000, continuous_update=True, description=\"Threshold\")\n",
    "display(widgets.HBox([slice_slider, thresh_slider]), out1)\n",
    "widgets.interactive_output(update_threshold_plot, {\"slice_idx\": slice_slider, \"threshold\": thresh_slider})"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "m3",
   "metadata": {},
   "source": [
    "## 2. Morphological Opening"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c3",
   "metadata": {},
