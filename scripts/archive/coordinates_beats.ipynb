   "source": [
    "# Segmentation of Beads CTpreop\n",
    "\n",
    "Pipeline:\n",
    "1. Interactive Thresholding\n",
    "2. Morphological Opening\n",
    "3. 3D Visualization\n",
    "4. Watershed Segmentation\n",
    "5. Individual Bead Inspection\n",
    "6. Saving the Result"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c1",
   "metadata": {},
