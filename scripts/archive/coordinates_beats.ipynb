   "source": [
    "from mpl_toolkits.mplot3d.art3d import Poly3DCollection\n",
    "\n",
    "def plot_beads_3d_colored(labels_volume):\n",
    "    fig = plt.figure(figsize=(10, 10))\n",
    "    ax = fig.add_subplot(111, projection='3d')\n",
    "\n",
    "    n_labels = int(labels_volume.max())\n",
    "    cmap = plt.cm.get_cmap('nipy_spectral', max(2, n_labels + 1))\n",
    "\n",
    "    for i in range(1, n_labels + 1):\n",
    "        mask = (labels_volume == i)\n",
    "        if not np.any(mask):\n",
    "            continue\n",
    "        try:\n",
    "            verts, faces, normals, values = measure.marching_cubes(mask, 0.5)\n",
    "            # ensure a valid RGBA color (fraction between 0 and 1)\n",
    "            frac = (i % max(1, n_labels)) / max(1, n_labels)\n",
    "            color = cmap(frac)\n",
    "            # create mesh with explicit facecolor to avoid black/transparent faces\n",
    "            mesh = Poly3DCollection(verts[faces], facecolor=color, edgecolor='k', linewidths=0.2, alpha=0.9)\n",
    "            ax.add_collection3d(mesh)\n",
    "        except Exception as e:\n",
    "            print(f\"Label {i}: marching_cubes failed: {e}\")\n",
    "\n",
    "    ax.set_xlim(0, labels_volume.shape[0])\n",
    "    ax.set_ylim(0, labels_volume.shape[1])\n",
    "    ax.set_zlim(0, labels_volume.shape[2])\n",
    "    ax.set_title(f'3D beads (N={n_labels})')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Call the function to display the colored 3D visualization\n",
    "plot_beads_3d_colored(labels)"
   ]
  },
  {
